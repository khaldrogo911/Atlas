# ==============================================================================
# Project Atlas — environment template
#
# Copy to `.env` and fill in locally:   cp .env.example .env
# `.env` is git-ignored and MUST NEVER be committed.
#
# Precedence (highest first):
#   1. process environment variables
#   2. .env file
#   3. config/<ATLAS_ENV>/*.toml
#   4. config/default/*.toml
#
# Nested settings use a double-underscore delimiter, e.g.
#   ATLAS_POSTGRES__HOST  ->  settings.postgres.host
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# One of: development | demo | production
ATLAS_ENV=development
ATLAS_APP_NAME=atlas-core
ATLAS_DEBUG=true

# Absolute path to the layered configuration directory. Leave unset to let
# Atlas discover the repository-local `config/` directory.
# ATLAS_CONFIG_DIR=/app/config

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
ATLAS_LOGGING__LEVEL=DEBUG
# One of: json | console
ATLAS_LOGGING__FORMAT=console

# ------------------------------------------------------------------------------
# PostgreSQL — system of record
# ------------------------------------------------------------------------------
ATLAS_POSTGRES__HOST=localhost
ATLAS_POSTGRES__PORT=5432
ATLAS_POSTGRES__DATABASE=atlas
ATLAS_POSTGRES__USER=atlas
ATLAS_POSTGRES__PASSWORD=change-me-locally
ATLAS_POSTGRES__POOL_MIN_SIZE=1
ATLAS_POSTGRES__POOL_MAX_SIZE=10

# Consumed by the postgres container in docker-compose.yml. Keep aligned with
# the ATLAS_POSTGRES__* values above.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-locally
# Host port published by the postgres container. Change it if 5432 is taken.
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis — cache, event bus transport
# ------------------------------------------------------------------------------
ATLAS_REDIS__HOST=localhost
ATLAS_REDIS__PORT=6379
ATLAS_REDIS__DATABASE=0
# Leave empty when the local instance has no password configured.
ATLAS_REDIS__PASSWORD=
# Host port published by the redis container. Change it if 6379 is taken.
# REDIS_PORT=6379

# ------------------------------------------------------------------------------
# DuckDB — analytical store for research and backtesting
# ------------------------------------------------------------------------------
ATLAS_DUCKDB__PATH=./data/atlas.duckdb
ATLAS_DUCKDB__READ_ONLY=false
ATLAS_DUCKDB__MEMORY_LIMIT=4GB

# ------------------------------------------------------------------------------
# Risk — portfolio limits
# ------------------------------------------------------------------------------
# Maximum portfolio margin/equity ratio, exclusive. A ratio, not a percentage:
# 0.5 permits new exposure only while pledged margin is below half of equity.
#
# The default is 0, and the comparison is strict, so the default permits
# nothing — absence is not permission. A development process starts on it and
# refuses every intent. A process started with ATLAS_ENV=demo or
# ATLAS_ENV=production does not start at all until this is set above zero, and
# no file under config/ sets it: every value is a trading policy and belongs to
# the deployment.
#
# Set it here rather than in TOML. This route converts to Decimal exactly; a
# bare TOML number is parsed as a float and loses precision before the settings
# model sees it.
# ATLAS_RISK__MAX_MARGIN_UTILISATION=0.5

# ------------------------------------------------------------------------------
# Broker — the trading account a session is opened against
# ------------------------------------------------------------------------------
# Four values, and they are the four a trading session cannot be established
# without. No layer under config/ sets any of them: a login, a server name and a
# terminal path are facts about a deployment rather than about the repository.
#
# All four are required. Start-up builds the trading adapter these values
# describe, and a login of 0 or an empty server name is rejected there, so a
# process without usable ones exits 2 before it reports anything else.
#
# ATLAS_BROKER__LOGIN=12345678
# ATLAS_BROKER__SERVER=YourProvider-Demo
# ATLAS_BROKER__TERMINAL_PATH=/absolute/path/to/your/trading-terminal
#
# The password is the one value of the four that may never be committed to a
# TOML layer. Supply it here or through the process environment only.
# ATLAS_BROKER__PASSWORD=
